# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Redis Configuration
REDIS_URL=redis://localhost:6379

# LLM Configuration
# Primary provider for this project: DeepSeek v4 pro
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional fallback: Local LLM via Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen2.5:7b-instruct

# Optional fallback: OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini Configuration for current mission
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_FLASH_MODEL=gemini-1.5-flash
EMBEDDING_PROVIDER=gemini

# Embedding Model Configuration
# Option 1: Local embedding model (HuggingFace)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu  # or 'cuda' if GPU available

# Option 2: OpenAI embedding (if using cloud-based)
USE_OPENAI_EMBEDDING=false

# Application Configuration
APP_NAME=RAG Enterprise System
APP_ENV=development  # or 'production'
LOG_LEVEL=INFO
DEBUG=true

# Data Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=2200
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=500
CHILD_CHUNK_OVERLAP=80
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.15

# Mission Dataset Verification
VERIFY_DATASET_NAME=sailor2/Vietnamese_RAG
VERIFY_DATASET_CONFIG=BKAI_RAG
VERIFY_RECORD_LIMIT=50
CHROMA_DB_PATH=./chroma_db/
INDEX_EMBEDDING_BATCH_SIZE=10
INDEX_BATCH_SLEEP_SECONDS=1.0

# Security & Data Localization
DATA_STORAGE_PATH=/home/ubuntu/rag_enterprise_system/data
ENABLE_DATA_ENCRYPTION=true
COMPLY_WITH_VIETNAM_LAW=true

# Vietnamese NLP
USE_VIETNAMESE_SEGMENTATION=true
UNDERTHESEA_MODEL_PATH=./models/underthesea

# FastAPI Configuration (for future backend)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Streamlit Configuration
STREAMLIT_PORT=8501
STREAMLIT_THEME=light
